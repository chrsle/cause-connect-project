<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Profile Page</title>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" 
        rel="stylesheet">
       
        <link rel="stylesheet" href="profileStyles.css">
    </head>
    <body style="background-color: rgb(25, 131, 248);">
        <h1>Create Nonprofit Profile</h1>
        <!-- Changed: Added form tag with correct action/method -->
        <form action="/nonprofit-profile" method="POST">
            <div class="menu">
                <div>
                    <h2> Nonprofit Organization Name</h2>
                </div>
                <div>
                    <!-- Changed: Added name attribute -->
                    <input name="nonprofitName" type="text" class="inputBox" placeholder="Enter noprofit organization name" required>
                </div>
                <div>
                    <h2> Location </h2>
                </div>
                <div>
                    <!-- Changed: Added name attribute -->
                    <input name="location" type="text" class="inputBox" placeholder="Enter location" required>
                </div>

                <div>
                    <h2> Category </h2>
                </div>
                <div>
                    <!-- Changed: Added name attribute -->
                    <input name="category" type="text" class="inputBox" placeholder="Enter category name" required>
                </div>
            </div>
            
            <div class="personalBioGrid">
                <div>
                    <h2> Mission Statemnet </h2>
                </div>
                <div>
                    <!-- Changed: Added name attribute -->
                    <textarea name="statement" placeholder="Enter a brief description of your mission or purpose here." required></textarea>
                </div>
            </div>

            <!-- Changed: Changed anchor tag to submit button -->
            <button type="submit" class="button">Complete Profile</button>
        </form>
    </body>
</html>