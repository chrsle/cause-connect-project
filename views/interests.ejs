<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>CauseConnect Practice</title>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" 
        rel="stylesheet">
       
        <link rel="stylesheet" href="Styles.css">
    </head>
    <body style="background-color: rgb(25, 131, 248);">

        <h1>What are your interests & passions?</h1>
        <h2 style = "color: black">Select all that apply</h2>

        <!-- Form element with action pointing to /interests -->
        <form class = "interest-page"action="/interests" method="POST">
            <div class="grid">
                <input type="checkbox" name="interests" id="Animals" value="Animals">
                <label for="Animals">Animals</label>
            </div>
        
            <div class="grid">
                <input type="checkbox" name="interests" id="Art&Culture" value="Art&Culture">
                <label for="Art&Culture">Art & Culture</label>
            </div>
        
            <div class="grid">
                <input type="checkbox" name="interests" id="Education" value="Education">
                <label for="Education">Education</label>
            </div>
        
            <div class="grid">
                <input type="checkbox" name="interests" id="Engineering" value="Engineering">
                <label for="Engineering">Engineering</label>
            </div>
        
            <div class="grid">
                <input type="checkbox" name="interests" id="Environment" value="Environment">
                <label for="Environment">Environment</label>
            </div>
        
            <div class="grid">
                <input type="checkbox" name="interests" id="Health&Wellness" value="Health&Wellness">
                <label for="Health&Wellness">Health & Wellness</label>
            </div>
        
            <div class="grid">
                <input type="checkbox" name="interests" id="Mathematics" value="Mathematics">
                <label for="Mathematics">Mathematics</label>
            </div>
        
            <div class="grid">
                <input type="checkbox" name="interests" id="Science" value="Science">
                <label for="Science">Science</label>
            </div>
        
            <div class="grid">
                <input type="checkbox" name="interests" id="SocialJustice" value="SocialJustice">
                <label for="SocialJustice">Social Justice</label>
            </div>
        
            <div class="grid">
                <input type="checkbox" name="interests" id="Sports&Fitness" value="Sports&Fitness">
                <label for="Sports&Fitness">Sports & Fitness</label>
            </div>
        
            <div class="grid">
                <input type="checkbox" name="interests" id="Technology" value="Technology">
                <label for="Technology">Technology</label>
            </div>

            <!-- Submit button to save the selected interests -->
            <button class = "interest-complete" type="submit">Complete Profile</button>
        </form>

    </body>
</html>
